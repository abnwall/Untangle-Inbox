<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>LDR Inbox</masterLabel>
    <description>Queue of Form Submissions for LDRs to claim, work and hand off.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="slaMinutes" type="Integer" default="15" label="Response target (minutes)"/>
            <property name="lookbackDays" type="Integer" default="30" label="Load unclaimed submissions from the last N days"/>
            <property name="refreshSeconds" type="Integer" default="60" label="Auto-refresh every N seconds (0 = off)"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
